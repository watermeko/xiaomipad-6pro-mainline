# Waydroid runs an Android userspace container on this kernel.  It needs the
# Binder IPC driver and binderfs; the rest of its requirements are already
# satisfied by the base configuration or liuqin-desktop.config:
#   PSI=y, MEMFD_CREATE=y, NET_NS=y, CGROUP_FREEZER=y (checked in the product
#   .config), and VETH is available as a module in the installed module tree.
# Binder is built in rather than modular because binderfs must be mounted early
# by the Waydroid init and because the persistent root's module set is pinned
# to this kernel's release; a built-in avoids adding a module there.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# Android's netd installs the container's default route and DNS through policy
# routing (ip rule), so the kernel needs the advanced router and multiple
# routing tables.  Without them the container comes up with only its on-link
# /24 route and has no internet.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# netd adds the container's policy rules for both IPv4 and IPv6 and aborts
# RouteController initialisation if either rule set is missing, so the IPv6
# table support is needed too.
CONFIG_IPV6_MULTIPLE_TABLES=y
