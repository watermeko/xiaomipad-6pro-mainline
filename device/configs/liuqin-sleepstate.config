# Tell the remote processors that the application processor is going to sleep.
#
# The DSPs decide whether to enter their own low power states from bit 12 of the
# SMP2P "sleepstate" entry on the SLPI edge.  Nothing in mainline writes it, and
# the firmware's counters on this tablet show the cost: `adsp` is awake
# essentially always (count 8, 6.4 s of sleep), `adsp_island` never increments,
# and `cxsd`, `ddr` and `aosd` stay at zero after every suspend, so CX and DDR
# never collapse and a suspended tablet draws 121 mA.
#
# The driver lives in kernel/patches until it is upstream.
CONFIG_QCOM_SMP2P_SLEEPSTATE=y
