# zram swap for liuqin (8 GiB SM8475 tablet, no swap device on the UFS layout).
#
# The installed system has no swap partition and no swapfile: the installer
# keeps the tail of the disk for the A/B slot layout, linux_home, and (in the
# dual-boot layout) the Android partition, so there is nothing to swapon.  The
# desktop idle baseline measured on the 8 GiB unit is ~2.9 GiB used, which
# leaves no headroom for a libwebkit2gtk application and OOM-kills instead of
# reclaiming.  zram is the only swap this product can have without giving up
# storage layout, and systemd-oomd (CONFIG_PSI, liuqin-desktop.config) can only
# do useful work once something is swappable.
#
# Built in, not modular: the generator unit runs from sysinit and the module
# tree is pinned to the product release, so a built-in avoids adding a module
# that the root filesystem manifest would have to carry.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# zstd: this is a mobile SoC where the compression cost is paid once per page
# and the memory saved is paid back on every later page touched.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# Recompress cold pages with a slower, denser stream once zram has been up for
# a while; with a single 8 GiB unit the density is worth more than the wakeup.
CONFIG_ZRAM_MULTI_COMP=y
# No writeback: the only backing store is the same UFS the swap is meant to
# avoid touching, and a swapfile on linux_root would collide with the storage
# guard's read-only remount path.
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MEMORY_TRACKING is not set

# zswap is deliberately left off.  It would sit in front of a real swap device
# that this product does not have, and zram already spends the compressed pool
# where the memory pressure is.
# CONFIG_ZSWAP is not set
