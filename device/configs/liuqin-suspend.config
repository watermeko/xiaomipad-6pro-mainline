# Sleep diagnostics.
#
# PM_SLEEP_DEBUG prints "PM: Triggering wakeup from IRQ N" for the interrupt
# that ends a suspend and exports /sys/power/pm_wakeup_irq for the next one.
# Without it an early wake cannot be attributed at all on this board: the
# wakeup-source counters in /sys/kernel/debug/wakeup_sources only cover
# devices that call pm_wakeup_event(), and the PMIC/RSC path that actually
# wakes the AP does not.  A suspend that asked for 25 minutes ended after 5
# minutes 45 seconds with every one of those counters at zero, and the same
# thing happens to roughly one suspend in three, at unpredictable durations.
#
# The cost is a few printk format strings; nothing here is on by default at
# runtime (pm_debug_messages starts at N).  Keep it: the next such report is
# only diagnosable with these two symbols in the product kernel.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
