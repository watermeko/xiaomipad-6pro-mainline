[Unit]
Description=liuqin on-screen keyboard
# Must come after the compositor: KWin evaluates window rules when the window
# appears, and the keyboard's own window is what the rules dock.
After=plasma-kwin_wayland.service
PartOf=graphical-session.target

[Service]
Environment=LIUQIN_OSK_LAYER=0
Environment=XDG_CURRENT_DESKTOP=KDE
ExecStart=/usr/local/bin/liuqin-osk
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
