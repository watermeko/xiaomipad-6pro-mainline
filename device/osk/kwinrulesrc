# KWin window rules that turn the plain-window keyboard into a docked panel.
#
# The layer-shell variant never receives pointer events on this compositor, so
# the keyboard runs as an ordinary toplevel and this rule gives it the dock
# behaviour: pinned to the bottom edge above Plasma Mobile's navigation bar
# (which occupies 0,864 1440x36), no decoration, never focusable.
#
# acceptfocus=false is the important part: the keyboard types through uinput, so
# the focused text field has to keep the keyboard focus; without this, tapping a
# key would activate the keyboard window and the injected keys would go to it.
#
# Verified: with this rule the window reports frameGeometry 0,526 1440x338.
# Note that a `types=` key aborts the match, so do not add one.
#
# Install to ~/.config/kwinrulesrc (merge if the user already has rules) and
# call `qdbus org.kde.KWin /KWin reconfigure`.
[General]
count=1
rules=1

[1]
Description=mytouchinput dock
enabled=true
wmclass=org.liuqin.TouchInput
wmclasscomplete=false
wmclassmatch=1
position=0,526
positionrule=2
size=1440,338
sizerule=2
acceptfocus=false
acceptfocusrule=2
keepabove=true
keepaboverule=2
noborder=true
noborderrule=2
skiptaskbar=true
skiptaskbarrule=2