#!/usr/bin/env python3
"""liuqin-stap - tap the screen at true logical coordinates.

The panel is physically portrait and the compositor applies
`wl_output transform 270`, so a touchscreen device's axes are rotated and
anisotropically scaled relative to the logical screen: aiming at screen (sx, sy)
needs tap coordinates

    tap_x = (OFFSET_Y - sy) / -SLOPE_Y
    tap_y = sx / SCALE_X

The constants below were calibrated from two probes on this unit (a tap at screen
(433,797) landed on window-local (1274,103) and one at (250,700) on (1119,217),
with the docked keyboard's window origin at y=526).

    sudo liuqin-tapd &
    liuqin-stap 433 797
"""

import subprocess
import sys
import time

SCALE_X = 1.598    # screen_x = 1.598 * tap_y
SLOPE_Y = -0.623   # screen_y = -0.623 * tap_x + OFFSET_Y
OFFSET_Y = 899.0

TAP = "/usr/local/bin/liuqin-tap"


def to_tap(sx, sy):
    return ((OFFSET_Y - sy) / -SLOPE_Y, sx / SCALE_X)


def tap(sx, sy, hold=1.0):
    tx, ty = to_tap(sx, sy)
    subprocess.run(["sudo", TAP, "%.0f" % tx, "%.0f" % ty], check=False)
    time.sleep(hold)


def main(argv):
    if len(argv) != 3:
        print("usage: liuqin-stap <x> <y>   (logical screen pixels)", file=sys.stderr)
        return 2
    tap(float(argv[1]), float(argv[2]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
