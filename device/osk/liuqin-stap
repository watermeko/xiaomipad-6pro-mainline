#!/usr/bin/env python3
"""liuqin-stap - tap the screen at true logical coordinates.

Kept as an alias: the rotation used to be done here, because the panel is
physically portrait and the compositor applies `wl_output transform 270`, so the
touchscreen's axes are rotated relative to the logical screen.  `liuqin-tapd`
now undoes that transform itself (`LIUQIN_TAP_ROTATE`, default 270), so
`liuqin-tap` takes logical screen pixels directly and this is a thin wrapper.

    sudo liuqin-tapd &
    liuqin-stap 433 797
"""

import subprocess
import sys
import time

TAP = "/usr/local/bin/liuqin-tap"


def main(argv):
    if len(argv) != 3:
        print("usage: liuqin-stap <x> <y>   (logical screen pixels)", file=sys.stderr)
        return 2
    subprocess.run(["sudo", TAP, argv[1], argv[2]], check=False)
    time.sleep(1.0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
