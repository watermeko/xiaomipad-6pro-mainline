#!/bin/sh
# gtk4-layer-shell has to be loaded before libwayland-client or layer surfaces
# silently fail to initialise ("GtkWindow is not a layer surface").
# https://github.com/wmww/gtk4-layer-shell/blob/main/linking.md
LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgtk4-layer-shell.so.0${LD_PRELOAD:+:$LD_PRELOAD}
export LD_PRELOAD
exec python3 /usr/local/share/liuqin-osk/liuqin-osk.py "$@"
