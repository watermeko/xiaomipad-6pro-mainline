#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Boot-time re-announce of iio-sensor-proxy for the boot-time display stack.
#
# A compositor claims the accelerometer only at the moment the SensorProxy
# D-Bus name appears while the shell is already running (2026-09-12 root
# cause).  A fixed sleep after graphical.target is the same race the
# session-side helper had (21:14 boot evidence): the restart can land while
# the greeter shell is still initializing and the re-appearance is missed.
# With no greeter session bus to wait on from the system context, this
# helper instead restarts the proxy and VERIFIES that a claim landed
# (proxy CPU advances = someone is streaming), retrying with backoff long
# enough to cover the slowest plausible greeter start.
set -u

log() { printf 'liuqin-sensor-proxy-refresh: %s\n' "$*" >&2; }

round=1
while [ $round -le 5 ]; do
	systemctl restart iio-sensor-proxy.service || :
	sleep 4
	pid=$(pgrep -f '^/usr/libexec/iio-sensor-proxy' | head -1 || :)
	if [ -n "$pid" ]; then
		a=$(awk '{print $14+$15}' "/proc/$pid/stat" 2>/dev/null || echo 0)
		sleep 4
		b=$(awk '{print $14+$15}' "/proc/$pid/stat" 2>/dev/null || echo 0)
		if [ "${b:-0}" -gt "${a:-0}" ]; then
			log "accelerometer claim established (round $round)"
			exit 0
		fi
	fi
	log "no claim after proxy restart (round $round); retrying"
	round=$((round + 1))
	sleep 10
done
log 'no claim after 5 rounds; greeter rotation will need a later trigger'
exit 1
