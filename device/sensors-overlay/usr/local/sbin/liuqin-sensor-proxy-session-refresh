#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Re-announce iio-sensor-proxy to THIS session's compositor, deterministically.
#
# A compositor claims the accelerometer only at the moment the SensorProxy
# D-Bus name appears (2026-09-12 root cause, found on gnome-shell), so the
# proxy must re-appear while the compositor is watching.  A fixed sleep after
# graphical-session.target is a race: the target fires while the compositor is
# still initializing and the re-appearance is missed (2026-09-12 21:14 boot
# evidence).  Instead:
#
#   1. wait until the session's compositor owns its bus name (org.kde.KWin on
#      Plasma Mobile; it is KWin's orientation sensor that reads the proxy) and
#      let its output setup settle;
#   2. restart the proxy so its name re-appears;
#   3. verify a claim actually landed (proxy CPU advances = streaming);
#      retry a bounded number of times, then give up loudly.
#
# Runs as the session user from liuqin-sensor-proxy-session-refresh.service;
# the proxy restart is permitted by the unit+verb-bounded polkit rule in
# 49-liuqin-sensorproxy.rules.
set -u

log() { printf 'liuqin-sensor-proxy-session-refresh: %s\n' "$*" >&2; }

owner=
i=0
while [ $i -lt 90 ]; do
	owner=$(gdbus call --session -d org.freedesktop.DBus -o /org/freedesktop/DBus \
		-m org.freedesktop.DBus.GetNameOwner org.kde.KWin 2>/dev/null) && break
	i=$((i + 1))
	sleep 1
done
case $owner in
	*':'*) ;;
	*) log 'the session compositor never appeared on the session bus; aborting'; exit 1 ;;
esac

# The compositor name is acquired before its output setup completes.
sleep 3

round=1
while [ $round -le 3 ]; do
	systemctl restart iio-sensor-proxy.service || :
	sleep 4
	pid=$(pgrep -f '^/usr/libexec/iio-sensor-proxy' | head -1 || :)
	if [ -n "$pid" ]; then
		a=$(awk '{print $14+$15}' "/proc/$pid/stat" 2>/dev/null || echo 0)
		sleep 4
		b=$(awk '{print $14+$15}' "/proc/$pid/stat" 2>/dev/null || echo 0)
		if [ "${b:-0}" -gt "${a:-0}" ]; then
			log 'accelerometer claim established'
			exit 0
		fi
	fi
	log "no claim after proxy restart (round $round); retrying"
	round=$((round + 1))
done
log 'claim never established; giving up'
exit 1
