[Unit]
# A compositor only establishes its accelerometer claim when the SensorProxy
# name appears while the shell is already running (2026-09-12 boot-0 evidence:
# a proxy started before the shell leaves the session claimless and rotation
# dead until a manual restart).  The proxy is therefore no longer boot-started
# (see liuqin-sensor-stack.target); this unit re-announces it once the display
# stack is up, so its appearance lands inside a live greeter session.  The
# helper verifies the claim with bounded retries -- a fixed sleep is a race
# (2026-09-12 21:14 session-side evidence).
Description=Re-announce iio-sensor-proxy to the boot-time display stack
After=graphical.target
Wants=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-sensor-proxy-refresh

[Install]
WantedBy=graphical.target
