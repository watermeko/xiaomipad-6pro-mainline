#!/bin/sh
# Proceed only when the boot menu recorded a HyperOS choice.
#
# liuqin-boot-menu.service triggers the switch on any failure, because systemd
# cannot match a single exit code.  The menu drops /run/liuqin-boot-menu/hyperos
# only when HyperOS was really chosen; every other failure leaves the marker
# absent and boot_a untouched.
set -eu

[ -f /run/liuqin-boot-menu/hyperos ]
