# Hide the Android firmware partitions from the desktop.
#
# The stock layout leaves a dozen partitions with real filesystems on the
# internal UFS storage: ext4 "metadata", "persist", "persistbak", "dsp_a",
# "dsp_b", "vm-bootsys_a", "vm-bootsys_b"; vfat "logfs", "modem_a", "modem_b",
# "bluetooth_a", "bluetooth_b", "qmcs"; and an erofs "cust".  udisks2 reports
# every one of them as a mountable volume, so GNOME lists them in the dock and
# in Files as anonymous "31 MB Volume" / "67 MB Volume" entries, and two of
# them as "dsp" and "LOGFS".
#
# None of these is meant to be mounted from the desktop.  They hold boot
# firmware, modem images and calibration data, and mounting one read-write is a
# good way to lose a partition that the bootloader needs.  UDISKS_IGNORE makes
# udisks2 skip the device entirely: it disappears from udisks, from the GVfs
# volume monitor, and therefore from the dock, the Files sidebar and any other
# consumer of the volume monitor.
#
# The match is deliberately narrow.  It keys on the internal UFS controller in
# DEVPATH rather than on sd* names, because the kernel numbers the internal
# disks sda..sdf here and a USB stick would otherwise be caught by the same
# pattern and vanish from the desktop too.  The two Linux partitions are kept
# because they are the system itself.
#
# This does not touch the device nodes: the fingerprint runtime and the boot
# tooling open /dev/disk/by-partlabel/* directly and never go through udisks.
ACTION!="remove", SUBSYSTEM=="block", KERNEL=="sd[a-z][0-9]*", \
  ENV{DEVPATH}=="*/1d84000.ufshc/*", \
  ENV{ID_PART_ENTRY_NAME}!="linux_root", \
  ENV{ID_PART_ENTRY_NAME}!="linux_home", \
  ENV{UDISKS_IGNORE}="1"
