[Unit]
Description=Rebuild the USB gadget when the link returns
Documentation=file:///usr/local/sbin/liuqin-usb-gadget-watch
# The gadget itself has to exist before its UDC state means anything.
After=liuqin-usb-gadget.service
Requires=liuqin-usb-gadget.service
# Off by default, and deliberately so.  The watcher rebuilds the gadget by
# tearing down configfs and creating it again, and when a host is attached the
# rebuild races the role switch: the log of one incident ends with
# FUNCTIONFS_SUSPEND, "Set phy mode to usb host" and the xHCI host controller
# probing on the same port that still has a cable in it, and the tablet
# rebooted.  Another left it frozen until a power-key reset.  Until the rebuild
# is gated on "no partner on the port", this is an opt-in recovery tool:
#
#   touch /etc/liuqin-usb-gadget-watch-enabled && systemctl start liuqin-usb-gadget-watch
ConditionPathExists=/etc/liuqin-usb-gadget-watch-enabled

[Service]
Type=simple
ExecStart=/usr/local/sbin/liuqin-usb-gadget-watch
# A watcher that dies is a watcher that silently stops recovering the link.
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
