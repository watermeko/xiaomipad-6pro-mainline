#!/bin/sh
# SPDX-License-Identifier: MIT
# Fixed desktop actions for liuqin-power-keyd. Never power off directly.
#
# The desktop is Plasma Mobile (KWin).  The GNOME build drove the shield and
# the panel through org.gnome.ScreenSaver and org.gnome.Mutter.DisplayConfig;
# neither exists under KWin.  The equivalents are:
#
#   lock state / lock the session   org.freedesktop.ScreenSaver on /ScreenSaver
#                                   (KWin owns that name and implements it)
#   blank / wake the panel          kscreen-doctor --dpms off|on
#   "is the panel already off"      kscreen-doctor --dpms show
#
# kscreen-doctor talks to the compositor over WAYLAND_DISPLAY, so the session
# environment below has to carry that socket name as well as D-Bus.
set -eu

action=${1:-}
loginctl=${LIUQIN_LOGINCTL:-/usr/bin/loginctl}
gdbus=${LIUQIN_GDBUS:-/usr/bin/gdbus}
gsettings=${LIUQIN_GSETTINGS:-/usr/bin/gsettings}
systemctl=${LIUQIN_SYSTEMCTL:-/usr/bin/systemctl}
systemd_run=${LIUQIN_SYSTEMD_RUN:-/usr/bin/systemd-run}
power_menu=${LIUQIN_POWER_MENU:-/usr/local/libexec/liuqin-power-menu}
power_schema_dir=${LIUQIN_POWER_SCHEMA_DIR:-/usr/share/liuqin/power}
setpriv=${LIUQIN_SETPRIV:-/usr/bin/setpriv}
getent=${LIUQIN_GETENT:-/usr/bin/getent}
env_cmd=${LIUQIN_ENV:-/usr/bin/env}
kscreen_doctor=${LIUQIN_KSCREEN_DOCTOR:-/usr/bin/kscreen-doctor}
runtime_base=${LIUQIN_RUNTIME_BASE:-/run/user}
state_dir=${LIUQIN_STATE_DIR:-/run/liuqin-power-keyd}

case $action in short|long) ;; *) exit 64 ;; esac

session=$("$loginctl" show-seat seat0 --property=ActiveSession --value 2>/dev/null || :)
[ -n "$session" ] && [ "$session" != n/a ] || {
	echo "liuqin-power-key-action: no active seat0 session; $action ignored" >&2
	exit 3
}
active=$("$loginctl" show-session "$session" --property=Active --value 2>/dev/null || :)
class=$("$loginctl" show-session "$session" --property=Class --value 2>/dev/null || :)
uid=$("$loginctl" show-session "$session" --property=User --value 2>/dev/null || :)
name=$("$loginctl" show-session "$session" --property=Name --value 2>/dev/null || :)
[ "$active" = yes ] && [ "$class" = user ] || {
	echo "liuqin-power-key-action: seat0 session is not an active user; $action ignored" >&2
	exit 3
}
case $uid in ''|*[!0-9]*) exit 3 ;; esac
[ "$uid" -ge 1000 ] && [ -n "$name" ] || exit 3

passwd_entry=$("$getent" passwd "$uid" 2>/dev/null || :)
[ -n "$passwd_entry" ] || exit 3
gid=$(printf '%s\n' "$passwd_entry" | cut -d: -f4)
home=$(printf '%s\n' "$passwd_entry" | cut -d: -f6)
case $gid in ''|*[!0-9]*) exit 3 ;; esac
runtime=$runtime_base/$uid
# The service deliberately has no DAC bypass capability. Check the 0700
# runtime directory as its owner, just like the D-Bus call below.
"$setpriv" --reuid="$uid" --regid="$gid" --clear-groups -- \
	/usr/bin/test -S "$runtime/bus" || {
	echo "liuqin-power-key-action: active session has no D-Bus; $action ignored" >&2
	exit 3
}

# The compositor socket is wayland-0 on this image, but it is a per-session
# name, so read it instead of assuming: kscreen-doctor fails without it.
wayland_display=
for socket in "$runtime"/wayland-*; do
	[ -S "$socket" ] || continue
	wayland_display=${socket##*/}
	break
done

session_command() {
	"$setpriv" --reuid="$uid" --regid="$gid" --clear-groups -- \
		"$env_cmd" -i \
		HOME="$home" USER="$name" LOGNAME="$name" \
		XDG_RUNTIME_DIR="$runtime" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
		${wayland_display:+WAYLAND_DISPLAY="$wayland_display"} \
		PATH=/usr/bin:/bin GSETTINGS_SCHEMA_DIR="$power_schema_dir" \
		"$@"
}

session_call() {
	session_command "$gdbus" call --session --timeout 5 "$@"
}

if [ "$action" = short ]; then
	policy=$(session_command "$gsettings" get io.github.liuqin.power short-press-action)
	case $policy in
		"'blank'") policy=blank ;;
		"'suspend'") policy=suspend ;;
		"'nothing'") exit 0 ;;
		*) exit 3 ;;
	esac
	[ -d "$state_dir" ] && [ ! -L "$state_dir" ] || exit 3
	state_file=$state_dir/display-state
	state=$(cat "$state_file" 2>/dev/null || :)
	case $state in off|on-locked|suspend-requested|'') ;; *) state= ;; esac

	# Is the lock screen in front?  KWin implements org.freedesktop.ScreenSaver
	# for the session, which is the same interface the GNOME build used.
	locked_reply=$(session_call \
		--dest org.freedesktop.ScreenSaver \
		--object-path /ScreenSaver \
		--method org.freedesktop.ScreenSaver.GetActive 2>/dev/null || :)
	case $locked_reply in *true*) locked=yes ;; *) locked=no ;; esac

	# Is the panel already blanked?  PowerDevil's idle blank does not go
	# through this script, so the state file alone cannot answer that.
	dpms_reply=$(session_command "$kscreen_doctor" --dpms show 2>/dev/null || :)
	case $dpms_reply in
	*": off"*) dpms_off=yes ;;
	*) dpms_off=no ;;
	esac

	# Snapshot before locking. If the idle path already put the shield up, this
	# press is a wake request, not a request to blank the panel again.  The
	# explicit state survives KWin independently seeing KEY_POWER: after our own
	# DPMS-off, KWin may have changed mode back before release, but `off` still
	# makes this release a wake.
	if [ "$state" = suspend-requested ]; then
		# The wake key must not request a second suspend even if KWin already
		# removed a passwordless screen shield before release.
		direction=on
	elif [ "$locked" = no ]; then
		direction=off
	elif [ "$state" = off ] || [ "$dpms_off" = yes ]; then
		direction=on
	else
		direction=off
	fi

	if [ "$direction" = off ]; then
		"$loginctl" lock-sessions
		session_call \
			--dest org.freedesktop.ScreenSaver \
			--object-path /ScreenSaver \
			--method org.freedesktop.ScreenSaver.SetActive true >/dev/null
		session_command "$kscreen_doctor" --dpms off >/dev/null
		new_state=off
		[ "$policy" != suspend ] || new_state=suspend-requested
	else
		# KWin has already seen the wake key.  Lighting the panel must not
		# re-lock the session; preserve the existing lock.
		session_command "$kscreen_doctor" --dpms on >/dev/null
		new_state=on-locked
	fi
	state_tmp=$state_file.$$
	(umask 077; printf '%s\n' "$new_state" >"$state_tmp")
	mv -f -- "$state_tmp" "$state_file"
	printf 'liuqin-power-key-action: display=%s\n' "$direction"
	if [ "$new_state" = suspend-requested ]; then
		"$systemctl" suspend
		printf '%s\n' 'liuqin-power-key-action: suspend requested'
	fi
else
	# The user manager supplies the real desktop environment. A named unit
	# prevents duplicate choosers and keeps the daemon free to observe keys.
	# The chooser has no timeout and performs nothing until a selection.
	session_command "$systemd_run" --user --quiet --collect \
		--unit=liuqin-power-menu "$power_menu"
	printf '%s\n' 'liuqin-power-key-action: power menu requested'
fi
